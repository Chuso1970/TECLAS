<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Control Deck</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0f172a;
      --text: #e5e7eb;
      --muted: #94a3b8;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 20px;
      background: linear-gradient(135deg, #020617, #111827 70%, #0f172a);
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
    }

    .shell {
      width: min(960px, calc(100vw - 24px));
      margin: 0 auto;
      display: grid;
      gap: 16px;
    }

    .panel {
      background: rgba(15, 23, 42, 0.92);
      border-radius: 18px;
      padding: 14px;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 0.9rem;
      color: var(--text);
    }

    input, select {
      width: 100%;
      border: 1px solid #334155;
      border-radius: 10px;
      background: #0f172a;
      color: #fff;
      padding: 8px;
    }

    .shortcut-row {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .shortcut-row input {
      flex: 1;
    }

    .shortcut-row button {
      border: none;
      border-radius: 10px;
      background: #334155;
      color: #fff;
      padding: 8px 10px;
      cursor: pointer;
    }

    .pads {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
    }

    .pad {
      min-height: 120px;
      border: none;
      border-radius: 18px;
      background: linear-gradient(180deg, #334155, #0f172a);
      color: #fff;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.35);
    }

    .pad.active {
      background: linear-gradient(180deg, #22c55e, #0f172a);
      transform: scale(0.98);
    }

    .icon { font-size: 2rem; }
    .label { font-weight: 700; }
    .shortcut { color: var(--muted); font-size: 0.78rem; }

    @media (max-width: 700px) {
      .pads { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="panel">
      <div class="controls">
        <label>
          Botón
          <select id="padSelector">
            <option value="0">1</option>
            <option value="1">2</option>
            <option value="2">3</option>
            <option value="3">4</option>
            <option value="4">5</option>
            <option value="5">6</option>
            <option value="6">7</option>
            <option value="7">8</option>
            <option value="8">9</option>
            <option value="9">0</option>
            <option value="10">Q</option>
            <option value="11">W</option>
            <option value="12">E</option>
            <option value="13">R</option>
            <option value="14">T</option>
          </select>
        </label>

        <label>
          Nombre
          <input id="labelInput" type="text" placeholder="Nombre visible" />
        </label>

        <label>
          Tecla asignada
          <div class="shortcut-row">
            <input id="shortcutInput" type="text" maxlength="10" placeholder="Pulsa una tecla" autocomplete="off" spellcheck="false" />
            <button id="clearShortcutButton" type="button">Borrar</button>
          </div>
        </label>

        <label>
          Audio propio
          <input id="audioInput" type="file" accept="audio/*" />
        </label>

        <label>
          Icono propio
          <input id="iconInput" type="file" accept="image/*" />
        </label>
      </div>
      <div style="margin-top: 12px; display: flex; gap: 10px; flex-wrap: wrap;">
        <button id="saveConfigButton" type="button">Guardar configuración</button>
        <button id="exportConfigButton" type="button">Guardar en archivo</button>
        <button id="importConfigButton" type="button">Cargar desde archivo</button>
        <input id="configFileInput" type="file" accept="application/json" style="display:none;" />
      </div>
    </div>

    <div class="panel">
      <div id="pads" class="pads" aria-label="Teclas de sonido"></div>
    </div>
  </div>

  <script>
    const padData = [
      { icon: '🎵', label: 'Beat', shortcut: '1', type: 'sine', freq: 220, gain: 0.17, attack: 0.02, release: 0.55, filter: 1200, q: 1.2 },
      { icon: '🎹', label: 'Piano', shortcut: '2', type: 'triangle', freq: 330, gain: 0.14, attack: 0.01, release: 0.62, filter: 1800, q: 0.9 },
      { icon: '🔊', label: 'Bass', shortcut: '3', type: 'sawtooth', freq: 110, gain: 0.19, attack: 0.03, release: 0.8, filter: 900, q: 1.5 },
      { icon: '🌩️', label: 'Thunder', shortcut: '4', type: 'square', freq: 165, gain: 0.16, attack: 0.01, release: 0.45, filter: 700, q: 1.0 },
      { icon: '🪩', label: 'Dance', shortcut: '5', type: 'triangle', freq: 392, gain: 0.15, attack: 0.02, release: 0.5, filter: 1500, q: 1.1 },
      { icon: '🎚️', label: 'Sweep', shortcut: '6', type: 'sine', freq: 294, gain: 0.13, attack: 0.02, release: 0.7, filter: 1600, q: 0.8 },
      { icon: '✨', label: 'Spark', shortcut: '7', type: 'square', freq: 466, gain: 0.12, attack: 0.01, release: 0.4, filter: 2100, q: 0.6 },
      { icon: '💥', label: 'Impact', shortcut: '8', type: 'sawtooth', freq: 148, gain: 0.2, attack: 0.005, release: 0.38, filter: 600, q: 1.8 },
      { icon: '🎶', label: 'Chime', shortcut: '9', type: 'triangle', freq: 523, gain: 0.11, attack: 0.015, release: 0.58, filter: 2500, q: 0.7 },
      { icon: '🎛️', label: 'Drop', shortcut: '0', type: 'square', freq: 88, gain: 0.21, attack: 0.03, release: 0.9, filter: 500, q: 2.0 },
      { icon: '🌊', label: 'Wave', shortcut: 'Q', type: 'sine', freq: 260, gain: 0.12, attack: 0.015, release: 0.6, filter: 1400, q: 0.9 },
      { icon: '🦋', label: 'Glow', shortcut: 'W', type: 'triangle', freq: 440, gain: 0.13, attack: 0.01, release: 0.55, filter: 1700, q: 0.8 },
      { icon: '🌈', label: 'Echo', shortcut: 'E', type: 'square', freq: 620, gain: 0.11, attack: 0.01, release: 0.5, filter: 2300, q: 0.7 },
      { icon: '🌙', label: 'Night', shortcut: 'R', type: 'sawtooth', freq: 180, gain: 0.16, attack: 0.02, release: 0.72, filter: 800, q: 1.2 },
      { icon: '⚡', label: 'Pulse', shortcut: 'T', type: 'sine', freq: 840, gain: 0.1, attack: 0.008, release: 0.4, filter: 2600, q: 0.6 }
    ];

    const grid = document.getElementById('pads');
    const padSelector = document.getElementById('padSelector');
    const labelInput = document.getElementById('labelInput');
    const shortcutInput = document.getElementById('shortcutInput');
    const clearShortcutButton = document.getElementById('clearShortcutButton');
    const saveConfigButton = document.getElementById('saveConfigButton');
    const exportConfigButton = document.getElementById('exportConfigButton');
    const importConfigButton = document.getElementById('importConfigButton');
    const configFileInput = document.getElementById('configFileInput');
    const audioInput = document.getElementById('audioInput');
    const iconInput = document.getElementById('iconInput');
    const STORAGE_KEY = 'control-deck-shortcuts-v1';
    let audioCtx = null;
    let activeCustomAudio = null;
    let activeSynth = null;
    let activePadIndex = null;

    function stopActiveSound() {
      if (activeCustomAudio) {
        activeCustomAudio.pause();
        activeCustomAudio.currentTime = 0;
        activeCustomAudio = null;
      }

      if (activeSynth) {
        try {
          activeSynth.oscillator.stop();
        } catch (error) {
          // El oscilador ya puede haber finalizado.
        }
        try {
          activeSynth.oscillator.disconnect();
          activeSynth.filter.disconnect();
          activeSynth.gain.disconnect();
        } catch (error) {
          // Ignoramos errores de desconexión.
        }
        activeSynth = null;
      }

      activePadIndex = null;
    }

    function updateButtonMarkup(button, pad) {
      const iconNode = button.querySelector('.icon');
      const labelNode = button.querySelector('.label');
      const shortcutNode = button.querySelector('.shortcut');
      if (pad.customIconUrl) {
        iconNode.innerHTML = `<img src="${pad.customIconUrl}" alt="${pad.label}" style="width: 42px; height: 42px; object-fit: cover; border-radius: 10px;">`;
      } else {
        iconNode.textContent = pad.icon;
      }
      labelNode.textContent = pad.label;
      shortcutNode.textContent = pad.shortcut ? `Tecla ${pad.shortcut}` : 'Sin tecla';
    }

    function createPadButton(pad, index) {
      const button = document.createElement('button');
      button.className = 'pad';
      button.type = 'button';
      button.innerHTML = `
        <div class="icon">${pad.icon}</div>
        <div class="label">${pad.label}</div>
        <div class="shortcut">Tecla ${pad.shortcut}</div>
      `;
      updateButtonMarkup(button, pad);
      button.addEventListener('click', () => triggerPad(index, button));
      grid.appendChild(button);
    }

    function storageAvailable(type) {
      try {
        const storage = window[type];
        const testKey = '__control_deck_test__';
        storage.setItem(testKey, '1');
        storage.removeItem(testKey);
        return true;
      } catch (error) {
        return false;
      }
    }

    function readStoredConfig() {
      const readers = [];
      if (storageAvailable('localStorage')) {
        readers.push(() => window.localStorage.getItem(STORAGE_KEY));
      }
      if (storageAvailable('sessionStorage')) {
        readers.push(() => window.sessionStorage.getItem(STORAGE_KEY));
      }
      readers.push(() => {
        const match = document.cookie.match(new RegExp('(?:^|; )' + STORAGE_KEY + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : null;
      });
      readers.push(() => {
        try {
          return window.name || null;
        } catch (error) {
          return null;
        }
      });

      for (const reader of readers) {
        const value = reader();
        if (value) return value;
      }
      return null;
    }

    function writeStoredConfig(payload) {
      const writers = [];
      if (storageAvailable('localStorage')) {
        writers.push(() => window.localStorage.setItem(STORAGE_KEY, payload));
      }
      if (storageAvailable('sessionStorage')) {
        writers.push(() => window.sessionStorage.setItem(STORAGE_KEY, payload));
      }
      writers.push(() => {
        document.cookie = `${STORAGE_KEY}=${encodeURIComponent(payload)}; path=/; max-age=31536000`;
      });
      writers.push(() => {
        try {
          window.name = payload;
        } catch (error) {
          // Ignoramos errores de la ventana.
        }
      });

      let wrote = false;
      for (const writer of writers) {
        try {
          writer();
          wrote = true;
        } catch (error) {
          // Continuamos con el siguiente método si uno falla.
        }
      }
      return wrote;
    }

    function fileToDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
        reader.readAsDataURL(file);
      });
    }

    async function assetToDataUrl(url) {
      if (!url) return '';
      if (url.startsWith('data:')) return url;
      if (!url.startsWith('blob:')) return url;
      const response = await fetch(url);
      const blob = await response.blob();
      return fileToDataUrl(new File([blob], 'asset', { type: blob.type }));
    }

    async function getConfigPayload() {
      const customAudioUrls = await Promise.all(padData.map((pad) => assetToDataUrl(pad.customAudioUrl || '')));
      const customIconUrls = await Promise.all(padData.map((pad) => assetToDataUrl(pad.customIconUrl || '')));
      return {
        version: 1,
        shortcuts: padData.map((pad) => pad.shortcut || ''),
        labels: padData.map((pad) => pad.label || ''),
        customAudioUrls,
        customIconUrls
      };
    }

    function saveShortcutConfig() {
      const shortcuts = padData.map((pad) => pad.shortcut || '');
      return writeStoredConfig(JSON.stringify(shortcuts));
    }

    async function exportConfigToFile() {
      const payload = JSON.stringify(await getConfigPayload(), null, 2);
      const blob = new Blob([payload], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'control-deck-config.json';
      link.click();
      URL.revokeObjectURL(url);
    }

    function importConfigFromFile(file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(reader.result);
          if (parsed.shortcuts && Array.isArray(parsed.shortcuts)) {
            parsed.shortcuts.forEach((shortcut, index) => {
              if (padData[index]) {
                padData[index].shortcut = shortcut || '';
              }
            });
          }
          if (parsed.labels && Array.isArray(parsed.labels)) {
            parsed.labels.forEach((label, index) => {
              if (padData[index]) {
                padData[index].label = label || padData[index].icon;
              }
            });
          }
          if (parsed.customAudioUrls && Array.isArray(parsed.customAudioUrls)) {
            parsed.customAudioUrls.forEach((url, index) => {
              if (padData[index] && url) {
                padData[index].customAudioUrl = url;
              }
            });
          }
          if (parsed.customIconUrls && Array.isArray(parsed.customIconUrls)) {
            parsed.customIconUrls.forEach((url, index) => {
              if (padData[index] && url) {
                padData[index].customIconUrl = url;
              }
            });
          }
          applyShortcutLabels();
          syncEditorForSelectedPad();
        } catch (error) {
          console.warn('No se pudo cargar el archivo de configuración', error);
        }
      };
      reader.readAsText(file);
    }

    function applyShortcutLabels() {
      padData.forEach((pad, index) => {
        const button = grid.children[index];
        if (button) updateButtonMarkup(button, pad);
      });
    }

    function loadShortcutConfig() {
      try {
        const saved = readStoredConfig();
        if (!saved) return false;
        const parsed = JSON.parse(saved);
        if (!Array.isArray(parsed)) return false;
        parsed.forEach((shortcut, index) => {
          if (padData[index]) {
            padData[index].shortcut = shortcut || '';
          }
        });
        applyShortcutLabels();
        return true;
      } catch (error) {
        console.warn('No se pudo cargar la configuración de teclas', error);
        return false;
      }
    }

    function getAudioContext() {
      if (!window.AudioContext && !window.webkitAudioContext) return null;
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      return audioCtx;
    }

    function unlockAudio() {
      const ctx = getAudioContext();
      if (!ctx) return Promise.resolve(false);
      if (ctx.state === 'suspended') {
        return ctx.resume().then(() => true).catch(() => false);
      }
      return Promise.resolve(true);
    }

    function playTone(config) {
      const ctx = getAudioContext();
      if (!ctx) return;

      stopActiveSound();

      const now = ctx.currentTime;
      const oscillator = ctx.createOscillator();
      const gain = ctx.createGain();
      const filter = ctx.createBiquadFilter();

      oscillator.type = config.type;
      oscillator.frequency.setValueAtTime(config.freq, now);
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(config.filter ?? 1200, now);
      filter.Q.value = config.q ?? 1;

      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(config.gain ?? 0.17, now + (config.attack ?? 0.02));
      gain.gain.exponentialRampToValueAtTime(0.0001, now + (config.release ?? 0.55));

      oscillator.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);

      activeSynth = { oscillator, gain, filter };
      oscillator.onended = () => {
        if (activeSynth && activeSynth.oscillator === oscillator) {
          activeSynth = null;
        }
      };

      oscillator.start(now);
      oscillator.stop(now + (config.release ?? 0.55) + 0.05);
    }

    function playCustomAudio(config) {
      if (!config.customAudioUrl) return false;

      stopActiveSound();

      const audio = new Audio(config.customAudioUrl);
      audio.loop = false;
      activeCustomAudio = audio;
      audio.onended = () => {
        if (activeCustomAudio === audio) {
          activeCustomAudio = null;
        }
      };

      audio.play().catch(() => {
        activeCustomAudio = null;
      });
      return true;
    }

    function triggerPad(index, button) {
      const pad = padData[index];
      if (!pad) return;

      if (activePadIndex === index) {
        stopActiveSound();
        return;
      }

      unlockAudio().then((ready) => {
        if (!ready) return;
        stopActiveSound();
        const played = playCustomAudio(pad);
        if (!played) playTone(pad);
        activePadIndex = index;
        button.classList.add('active');
        setTimeout(() => button.classList.remove('active'), 120);
      });
    }

    loadShortcutConfig();
    padData.forEach(createPadButton);

    function syncEditorForSelectedPad() {
      const index = Number(padSelector.value);
      const pad = padData[index];
      labelInput.value = pad.label;
      shortcutInput.value = pad.shortcut || '';
    }

    padSelector.addEventListener('change', syncEditorForSelectedPad);

    labelInput.addEventListener('input', () => {
      const index = Number(padSelector.value);
      padData[index].label = labelInput.value || padData[index].icon;
      const button = grid.children[index];
      if (button) updateButtonMarkup(button, padData[index]);
    });

    function formatShortcut(event) {
      if (event.key === ' ') return 'Space';
      if (['Escape', 'Enter', 'Tab', 'Backspace', 'Delete', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'].includes(event.key)) {
        return event.key;
      }
      if (['Shift', 'Control', 'Alt', 'Meta', 'CapsLock', 'ContextMenu'].includes(event.key)) {
        return '';
      }
      if (event.key.length === 1) {
        return event.key.toUpperCase();
      }
      return event.code || event.key;
    }

    shortcutInput.addEventListener('keydown', (event) => {
      const shortcut = formatShortcut(event);
      if (!shortcut) return;
      if (shortcut === 'Tab') return;
      event.preventDefault();
      event.stopPropagation();

      const index = Number(padSelector.value);
      padData[index].shortcut = shortcut;
      shortcutInput.value = shortcut;
      const button = grid.children[index];
      if (button) updateButtonMarkup(button, padData[index]);
      saveShortcutConfig();
    });

    clearShortcutButton.addEventListener('click', () => {
      const index = Number(padSelector.value);
      padData[index].shortcut = '';
      shortcutInput.value = '';
      const button = grid.children[index];
      if (button) updateButtonMarkup(button, padData[index]);
      saveShortcutConfig();
    });

    saveConfigButton.addEventListener('click', () => {
      const saved = saveShortcutConfig();
      saveConfigButton.textContent = saved ? 'Guardado ✓' : 'Error al guardar';
      setTimeout(() => {
        saveConfigButton.textContent = 'Guardar configuración';
      }, 1200);
    });

    exportConfigButton.addEventListener('click', exportConfigToFile);

    importConfigButton.addEventListener('click', () => {
      configFileInput.click();
    });

    configFileInput.addEventListener('change', () => {
      importConfigFromFile(configFileInput.files[0]);
      configFileInput.value = '';
    });

    audioInput.addEventListener('change', async () => {
      const index = Number(padSelector.value);
      const file = audioInput.files[0];
      if (!file) return;
      padData[index].customAudioUrl = await fileToDataUrl(file);
    });

    iconInput.addEventListener('change', async () => {
      const index = Number(padSelector.value);
      const file = iconInput.files[0];
      if (!file) return;
      padData[index].customIconUrl = await fileToDataUrl(file);
      const button = grid.children[index];
      if (button) updateButtonMarkup(button, padData[index]);
    });

    window.addEventListener('beforeunload', () => {
      saveShortcutConfig();
    });

    window.addEventListener('keydown', (event) => {
      if (event.target && ['INPUT', 'SELECT', 'TEXTAREA'].includes(event.target.tagName)) return;

      const key = event.key;
      const code = event.code;
      const candidates = [key, key.toLowerCase(), code, code.toLowerCase(), `${key}`.toLowerCase(), `${code}`.toLowerCase()];
      const shortcutMap = padData.reduce((map, pad, index) => {
        if (pad.shortcut) {
          const normalized = String(pad.shortcut).trim().toLowerCase();
          map[normalized] = index;
          if (normalized === 'space') {
            map[' '] = index;
          }
        }
        return map;
      }, {});
      const index = candidates.map((candidate) => shortcutMap[candidate]).find((value) => value !== undefined);
      if (index === undefined) return;
      event.preventDefault();
      const button = grid.children[index];
      if (button) triggerPad(index, button);
    });
  </script>
